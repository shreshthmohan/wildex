---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Wildlife Encounter Cards' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="bg-stone-100 text-stone-800 font-sans">
    <slot />
      <footer class="py-6 border-t border-gray-400 mt-8 md:mt-12 lg:mt-16">
      <div class="max-w-6xl px-4 mx-auto flex justify-between items-center">
        <div class="text-xl font-bold tracking-normal">Wildex</div>
        <div class="flex items-center gap-4 ">
          <div class="">
            <span class="inline-block transform rotate-180 text-lg mb-2">©</span>
            GPLv3 2025 -
            <a href="#" class="underline">Seek. Settle. Sustain.</a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
