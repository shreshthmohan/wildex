---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "Wildlife Encounter Cards" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="bg-stone-100 text-stone-800 font-sans">
    <slot />

    <footer class="py-8 border-t border-stone-300 mt-8 md:mt-12 lg:mt-16">
      <div class="max-w-6xl px-4 mx-auto">
        <div
          class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4"
        >
          <div class="text-2xl font-bold tracking-tight">Wildex</div>

          <div
            class="flex flex-col sm:flex-row items-start sm:items-center gap-4 sm:gap-6 text-sm"
          >
            <div>
              Made by <a
                href="https://twitter.com/shreshthmohan"
                class="hover:text-lime-600 underline decoration-lime-500 decoration-2 underline-offset-2"
                >Shreshth Mohan</a
              >
              to supplement <a
                href="https://blrhikes.com"
                class="hover:text-lime-600 underline decoration-lime-500 decoration-2 underline-offset-2"
                >BLR Hikes</a
              >
            </div>

            <div class="flex items-center gap-1.5">
              <span class="inline-block transform rotate-180 text-base">©</span
              >
              <a
                href="https://github.com/shreshthmohan/wildex"
                class="hover:text-lime-600 underline decoration-lime-500 decoration-2 underline-offset-2"
              >
                GPLv3 2025
              </a>
            </div>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
