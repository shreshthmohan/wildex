---
// IconLoader.astro - Dynamically loads icon components based on the provided name
const { iconName, className = "size-5" } = Astro.props;

// Try to dynamically import the component
let IconComponent;
try {
  IconComponent = (await import(`./fa-${iconName}.astro`)).default;
} catch (e) {
  console.error(`Failed to load icon component: fa-${iconName}.astro`);
}
---

{IconComponent ? <IconComponent className={className} /> : <span>Icon not found: {iconName}</span>}
