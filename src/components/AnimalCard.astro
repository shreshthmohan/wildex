---

interface Props {
  commonName: string;
  scientificName: string;
  region: string;
  image: string;
  imageAlt: string;
  habitat: {
    title: string;
    colorClass: string;
  };
  activity: {
    text: string;
  };
  encounterGuidance: {
    text: string;
  };
  presenceSigns: {
    text: string;
  };
  id: string;
  themeColor: string;
}

const { 
  id,
  commonName,
  scientificName,
  region,
  image,
  imageAlt,
  habitat,
  activity,
  encounterGuidance,
  presenceSigns,
  themeColor
} = Astro.props;

// Static class mappings for Tailwind
type ColorKey = 'amber' | 'blue' | 'brown' | 'slate' | 'yellow' | 'emerald' | string;



const textColorClasses: Record<ColorKey, string> = {
  amber: "text-amber-800",
  blue: "text-blue-800",
  brown: "text-amber-800", // Using amber as substitute for brown
  slate: "text-slate-800",
  yellow: "text-yellow-800",
  emerald: "text-emerald-800",
  default: "text-gray-800"
};


// Map for hover classes
const hoverClasses: Record<ColorKey, string> = {
  amber: "hover:text-amber-900",
  blue: "hover:text-blue-900",
  brown: "hover:text-amber-900",
  slate: "hover:text-slate-900",
  yellow: "hover:text-yellow-900",
  emerald: "hover:text-emerald-900",
  default: "hover:text-gray-900"
};

// No need to define a variable here as we're using the direct reference in the template
---

<div class="flex flex-col bg-white rounded-lg overflow-hidden shadow-md transition-all duration-300 hover:shadow-lg border border-stone-200">
  <a href={`/a/${id}`} class="relative">
    <img
      loading="lazy"
      src={image}
      alt={imageAlt}
      class="w-full h-auto object-contain"
    />
  </a>

  <div class="p-6 h-full">
    <div class="mb-4">
      <h2 class="text-2xl font-medium">{commonName}</h2>
      <p class="text-stone-500 italic text-base mt-1">
        {scientificName}
      </p>
    </div>

    <div class="mb-5">
      <span
        class="inline-block bg-emerald-100 text-emerald-800 text-sm px-3 py-1 rounded-full font-medium"
      >{region}</span>
    </div>

    <ul class="space-y-3 list-disc pl-5">
      {activity && <li >
        {activity.text}
      </li>}
      {encounterGuidance && <li >
        {encounterGuidance.text}
      </li>}
      {presenceSigns && <li >
        {presenceSigns.text}
      </li>}
    </ul>
  </div>

  <div class="bg-stone-50 px-6 py-4 border-t border-stone-200 mt-auto">
    <a
      href={`/a/${id}`}
      class={`${textColorClasses[themeColor] || textColorClasses.default} ${hoverClasses[themeColor] || hoverClasses.default} text-base font-medium flex items-center`}
    >
      I want to know more
      <span class="ml-2">→</span>
    </a>
  </div>
</div>
