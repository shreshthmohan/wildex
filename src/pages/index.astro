---
import Layout from '../layouts/Layout.astro';
import { animals } from '../data/animals.js';
import AnimalCard from '../components/AnimalCard.astro';

// Add these to Layout.astro head
const headContent = {
  title: 'Wildlife Encounter Cards',
};
---

<Layout {...headContent}>
  <div class="container mx-auto px-4 py-8">
    <header class="mb-10">
      <h1 class="text-4xl font-semibold text-stone-800 mb-2">
        Forest Beings
      </h1>
      <p class="text-stone-600 max-w-2xl text-xl font-light">
        Living wisely alongside the beings who shape and inhabit these
        landscapes
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
      {animals.map((animal) => (
        <AnimalCard {...animal} />
      ))}
    </div>
  </div>
</Layout>
