---
// Import the layout (assuming it exists)
import Layout from "../../layouts/Layout.astro";

import { getAnimalById, animals } from "../../data/animals.js";


export function getStaticPaths() {
  return animals.map((animal) => ({
    params: { slug: animal.id },
  }));
}



// slug
const { slug } = Astro.params;

// Get the animal data
const animal = getAnimalById(slug);

// Handle case where animal is not found
if (!animal) {
  Astro.response.status = 404;
  return Astro.response;
}

// Fallback images
const fallbackPugmark = "/images/fallback-pugmark.svg";
const fallbackScat = "/images/fallback-scat.jpg";
const fallbackHabitat = "/images/fallback-habitat.jpg";

// Use the actual images if available, otherwise use fallbacks
const pugmarkImage = animal.pugMarks?.image || fallbackPugmark;
const scatImage = animal.scat?.image || fallbackScat;
// Since we removed the image property from habitat, always use the fallback
const habitatImage = fallbackHabitat;
---

<Layout title={`${animal.commonName} | Forest Beings`}>
  <div class="container mx-auto px-4 py-8 max-w-6xl">
    <!-- Back Navigation -->
    <div class="mb-6">
      <a href="/" class="text-amber-700 hover:text-amber-900 flex items-center font-medium">
        ← Back to All Animals
      </a>
    </div>

    <!-- Hero Section -->
    <section class="bg-white rounded-xl overflow-hidden shadow-md mb-10 border border-stone-200">
      <div class="md:flex">
        <!-- Main Image -->
        <div class="md:w-1/2">
          <div class="relative h-full">
            <img 
              loading="lazy"
              src={animal.image} 
              alt={`${animal.commonName} in its natural habitat`} 
              class="w-full h-full object-cover" 
              style="min-height: 400px;"
            />
            <!-- Encounter Status Badge -->
            <div class="absolute top-4 right-4 bg-amber-500 text-white px-4 py-2 rounded-full font-medium">
              Potentially Dangerous
            </div>
          </div>
        </div>

        <!-- Hero Info -->
        <div class="md:w-1/2 p-8">
          <div class="mb-4">
            <h1 class="text-4xl font-bold text-stone-800 mb-2">{animal.commonName}</h1>
            <p class="text-stone-500 italic text-xl">{animal.scientificName}</p>
          </div>

          <!-- Region & Status -->
          <div class="flex flex-wrap gap-2 mb-6">
            <span class={`inline-block ${animal.regionClass} text-sm px-3 py-1 rounded-full font-medium`}>
              {animal.region}
            </span>
            {animal.conservationStatus && (
              <span class="inline-block bg-red-100 text-red-800 text-sm px-3 py-1 rounded-full font-medium">
                {animal.conservationStatus.status}
              </span>
            )}
          </div>

          <!-- Quick Facts -->
          <div class="mb-8">
            <ul class="space-y-3 list-disc pl-5">
              <li class="text-base">
                <span class="text-amber-800">{animal.activity.text}</span>
              </li>
              <li class="text-base">
                <span>{animal.encounterGuidance.text}</span>
              </li>
              <li class="text-base">
                <span>{animal.presenceSigns.text}</span>
              </li>
            </ul>
          </div>

          <!-- Physical Stats -->
          {animal.physicalDescription && (
            <div class="grid grid-cols-2 gap-4 text-sm">
              <div class="bg-stone-100 rounded-lg p-3">
                <span class="text-stone-500">Size</span>
                <p class="font-medium">{animal.physicalDescription.size}</p>
              </div>
              <div class="bg-stone-100 rounded-lg p-3">
                <span class="text-stone-500">Weight</span>
                <p class="font-medium">{animal.physicalDescription.weight}</p>
              </div>
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- Main Content Sections -->
    <div class="grid md:grid-cols-2 gap-8">
      <!-- Left Column: Identification -->
      <div class="md:col-span-1 space-y-8">
        <!-- Identification Section -->
        <section class="bg-white rounded-xl p-6 shadow-md border border-stone-200">
          <h2 class="text-2xl font-semibold mb-6 text-stone-800 flex items-center">

            Identification
          </h2>

          <!-- Appearance -->
          <div class="mb-6">
            <h3 class="font-medium text-lg mb-2">Appearance</h3>
            {animal.physicalDescription && (
              <>
                <p class="text-stone-700 mb-4">{animal.physicalDescription.appearance}</p>
                <ul class="space-y-2">
                  {animal.physicalDescription.distinctiveFeatures.map(feature => (
                    <li class="flex items-start">
                      <span class="text-emerald-600 mr-2">•</span>
                      <span>{feature}</span>
                    </li>
                  ))}
                </ul>
              </>
            )}
          </div>

          <!-- Pug Marks -->
          <div class="mb-6">
            <h3 class="font-medium text-lg mb-2">Pug Marks</h3>
            <div class="bg-stone-50 p-4 rounded-lg mb-4">
              <img 
                src={pugmarkImage} 
                alt={`${animal.commonName} pug mark illustration`} 
                class="w-full h-auto mb-3" 
              />
              <div class="flex justify-between text-sm text-stone-600">
                {animal.pugMarks && (
                  <>
                    <span>Width: {animal.pugMarks.width}</span>
                    <span>Length: {animal.pugMarks.length}</span>
                  </>
                )}
              </div>
            </div>
            <p class="text-stone-700">{animal.pugMarks?.description}</p>
          </div>

          <!-- Scat -->
          <div>
            <h3 class="font-medium text-lg mb-2">Scat</h3>
            {animal.scat && (
              <>
                <img 
                  src={scatImage} 
                  alt={`${animal.commonName} scat`} 
                  class="w-full h-auto rounded-lg mb-3 object-cover" 
                  style="max-height: 200px;"
                />
                <p class="text-stone-700">{animal.scat?.description}</p>
              </>
            )}
          </div>
        </section>

        <!-- Ecological Role Section -->
        <section class="bg-white rounded-xl p-6 shadow-md border border-stone-200">
          <h2 class="text-2xl font-semibold mb-6 text-stone-800 flex items-center">

            Ecological Role
          </h2>

          <!-- Diet -->
          <div class="mb-6">
            <h3 class="font-medium text-lg mb-2">Diet</h3>
            {animal.diet && (
              <div class="flex mb-4">
                <div class="mr-2 mt-1 font-bold text-amber-600">•</div>
                <div>
                  <h4 class="font-medium">Primary Food</h4>
                  <p class="text-stone-700 mb-2">
                    {animal.diet.primary.join(", ")}
                </p>
                <h4 class="font-medium">Also Eats</h4>
                <p class="text-stone-700 mb-2">
                  {animal.diet.secondary.join(", ")}
                </p>
                <p class="text-stone-700 text-sm italic">{animal.diet.notes}</p>
              </div>
            </div>
          )}
          </div>

          <!-- Behavior -->
          <div>
            <h3 class="font-medium text-lg mb-2">Behavior</h3>
            <ul class="space-y-3">
              <li class="flex">
                <span class="text-amber-600 mt-1 mr-3 w-5 text-center font-bold">•</span>
                <div>
                  <span class="font-medium">Social Structure:</span>
                  <p class="text-stone-700">{animal.behavior?.social}</p>
                </div>
              </li>
              <li class="flex">
                <span class="text-amber-600 mt-1 mr-3 w-5 text-center font-bold">•</span>
                <div>
                  <span class="font-medium">Movement:</span>
                  <p class="text-stone-700">{animal.behavior?.movement}</p>
                </div>
              </li>
              <li class="flex">
                <span class="text-amber-600 mt-1 mr-3 w-5 text-center font-bold">•</span>
                <div>
                  <span class="font-medium">Climbing:</span>
                  <p class="text-stone-700">{animal.behavior?.climbing}</p>
                </div>
              </li>
              <li class="flex">
                <span class="text-amber-600 mt-1 mr-3 w-5 text-center font-bold">•</span>
                <div>
                  <span class="font-medium">Sounds:</span>
                  <p class="text-stone-700">{animal.behavior?.sounds}</p>
                </div>
              </li>
            </ul>
          </div>
        </section>
      </div>

      <!-- Middle Column: Encounter Wisdom & Seasonal Patterns -->
      <div class="md:col-span-1 space-y-8">
        <!-- Encounter Wisdom -->
        <section class="bg-white rounded-xl p-6 shadow-md border border-stone-200">
          <h2 class="text-2xl font-semibold mb-6 text-stone-800 flex items-center">

            Encounter Wisdom
          </h2>

          <!-- Detailed Description -->
          <div class="mb-8 text-stone-700">
            {animal.detailedDescription && (
              <>
                <p class="mb-4">{animal.detailedDescription.split('\n\n')[0]}</p>
                <p>{animal.detailedDescription.split('\n\n')[1]}</p>
              </>
            )}
          </div>

          <!-- Human Interactions -->
          {animal.humanInteractions && (
            <div class="space-y-4">
              <div class="bg-red-50 border-l-4 border-red-500 p-4 rounded-r-lg">
                <h3 class="font-medium text-red-800 mb-1">If Encountered</h3>
                <p class="text-stone-700">{animal.humanInteractions.if_encountered}</p>
              </div>

            <div class="bg-amber-50 border-l-4 border-amber-500 p-4 rounded-r-lg">
              <h3 class="font-medium text-amber-800 mb-1">Known Behavior</h3>
              <p class="text-stone-700">{animal.humanInteractions.threats}</p>
            </div>

            <div class="bg-emerald-50 border-l-4 border-emerald-500 p-4 rounded-r-lg">
              <h3 class="font-medium text-emerald-800 mb-1">Prevention</h3>
              <p class="text-stone-700">{animal.humanInteractions.avoidance}</p>
            </div>
          </div>
        )}
        </section>

        <!-- Seasonal Patterns -->
        <section class="bg-white rounded-xl p-6 shadow-md border border-stone-200">
          <h2 class="text-2xl font-semibold mb-6 text-stone-800 flex items-center">

            Seasonal Patterns
          </h2>

          <div class="relative overflow-hidden">
            <!-- Calendar-like visual representation -->
            <div class="grid grid-cols-12 gap-2 mb-6">
              {Array.from({ length: 12 }).map((_, i) => {
                const month = new Date(0, i).toLocaleString('default', { month: 'short' });
                const isMating = i >= 5 && i <= 6; // June-July
                const isCubbing = i == 11 || i == 0; // Dec-Jan
                const isHighFruit = i >= 6 && i <= 9; // Monsoon & post-monsoon

                return (
                  <div class={`rounded-md p-2 text-center text-xs ${
                    isMating ? 'bg-rose-100 text-rose-800' : 
                    isCubbing ? 'bg-blue-100 text-blue-800' : 
                    isHighFruit ? 'bg-green-100 text-green-800' : 
                    'bg-stone-100 text-stone-400'
                  }`}>
                    {month}
                  </div>
                );
              })}
            </div>

            <!-- Legend -->
            <div class="flex flex-wrap gap-4 text-sm">
              <div class="flex items-center">
                <div class="w-4 h-4 rounded-sm bg-rose-100 border border-rose-200 mr-2"></div>
                <span>Mating</span>
              </div>
              <div class="flex items-center">
                <div class="w-4 h-4 rounded-sm bg-blue-100 border border-blue-200 mr-2"></div>
                <span>Cubs Born</span>
              </div>
              <div class="flex items-center">
                <div class="w-4 h-4 rounded-sm bg-green-100 border border-green-200 mr-2"></div>
                <span>Peak Fruit Foraging</span>
              </div>
            </div>
          </div>

          <!-- Seasonal Details -->
          <div class="mt-6 space-y-4">
            {animal.seasonalPatterns && (
              <>
                <div>
                  <h3 class="font-medium text-lg mb-1">Mating Season</h3>
                  <p class="text-stone-700">{animal.seasonalPatterns.mating}</p>
                </div>
                <div>
                  <h3 class="font-medium text-lg mb-1">Cubs</h3>
                  <p class="text-stone-700">{animal.seasonalPatterns.cubBirth}</p>
              </div>
              <div>
                <h3 class="font-medium text-lg mb-1">Foraging Patterns</h3>
                <p class="text-stone-700">{animal.seasonalPatterns.fruitForaging}</p>
              </div>
            </>
          )}
        </section>
      </div>

      <!-- Right Column: Habitat & Cultural Context -->
      <div class="md:col-span-1 space-y-8">
        <!-- Habitat -->
        <section class="bg-white rounded-xl p-6 shadow-md border border-stone-200">
          <h2 class="text-2xl font-semibold mb-6 text-stone-800 flex items-center">

            Habitat
          </h2>

          <!-- Habitat Image -->
          <div class="mb-6">
            <img 
              src={habitatImage} 
              alt={`Typical ${animal.commonName} habitat`} 
              class="w-full h-auto rounded-lg object-cover" 
              style="max-height: 200px;" 
            />
          </div>

          <!-- Habitat Information -->
          <div class="space-y-4">
            <div>
              <h3 class="font-medium text-lg mb-1">Primary Habitat</h3>
              <p class="text-stone-700">{animal.habitat.primary}</p>
            </div>
            {animal.habitat.preferredAreas && (
              <div>
                <h3 class="font-medium text-lg mb-1">Preferred Areas</h3>
                <ul class="space-y-1">
                  {animal.habitat.preferredAreas.map(area => (
                    <li class="flex items-start">
                    <i class="fas fa-check text-emerald-600 mt-1 mr-2"></i>
                    <span>{area}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
            <div>
              <h3 class="font-medium text-lg mb-1">Range</h3>
              <p class="text-stone-700">{animal.habitat.range}</p>
            </div>
          </div>
        </section>

        <!-- Conservation Status -->
        {animal.conservationStatus && (
          <section class="bg-white rounded-xl p-6 shadow-md border border-stone-200">
            <h2 class="text-2xl font-semibold mb-6 text-stone-800 flex items-center">

              Conservation Status
            </h2>

          <!-- Status -->
          <div class="mb-6">
            <div class="inline-block bg-red-100 text-red-800 px-4 py-2 rounded-lg font-medium mb-4">
              {animal.conservationStatus.status}
            </div>
            <p class="text-stone-700">Population: {animal.conservationStatus.population}</p>
          </div>

          <!-- Threats -->
          <div>
            <h3 class="font-medium text-lg mb-2">Primary Threats</h3>
            <ul class="space-y-2">
              {animal.conservationStatus.threats.map(threat => (
                <li class="flex items-start">
                  <span>{threat}</span>
                </li>
              ))}
            </ul>
          </div>
        </section>
        )}

        <!-- Cultural Context -->
        <section class="bg-white rounded-xl p-6 shadow-md border border-stone-200">
          <h2 class="text-2xl font-semibold mb-6 text-stone-800 flex items-center">

            Cultural Context
          </h2>

          <!-- Folklore -->
          <div class="mb-6">
            <h3 class="font-medium text-lg mb-1">Traditional Knowledge</h3>
            {animal.culturalSignificance && (
              <p class="text-stone-700">{animal.culturalSignificance.folklore}</p>
            )}
          </div>

          <!-- Local Names -->
          <div>
            <h3 class="font-medium text-lg mb-2">Local Names</h3>
            {animal.culturalSignificance && (
              <div class="grid grid-cols-2 gap-3">
                {Object.entries(animal.culturalSignificance.localNames).map(([language, name]) => (
                  <div class="bg-stone-50 rounded-lg p-3">
                    <span class="text-stone-500 text-sm capitalize">{language}</span>
                    <p class="font-medium">{name}</p>
                  </div>
                ))}
              </div>
            )}
          </div>
        </section>
      </div>
    </div>
  </div>
</Layout>